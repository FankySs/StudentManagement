@page
@model StudentManagement.Web.Pages.User.DashboardModel
@{
    ViewData["Title"] = "Uživatelský panel";
}

<div class="admin-container">
    <h2>Uživatelský panel</h2>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
            <div class="alert alert-info text-center">@Model.StatusMessage</div>
    }

    <form method="get" asp-page="Overview">
        <button type="submit" class="btn-admin primary">Přehled studentů a známek</button>
    </form>

    <form method="get" asp-page="Grades">
        <button type="submit" class="btn-admin secondary">Přidat známky</button>
    </form>

    <form method="post" asp-page-handler="Logout">
        <button type="submit" class="btn-admin outline">Odhlásit se</button>
    </form>
</div>

@section Styles {
        <style>
            .admin-container {
                max-width: 500px;
                margin: 120px auto;
                background-color: #f9f9f9;
                padding: 30px;
                border-radius: 12px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
                font-family: "Segoe UI", sans-serif;
            }

                .admin-container h2 {
                    text-align: center;
                    margin-bottom: 30px;
                    color: #333;
                }

            .btn-admin {
                width: 100%;
                padding: 12px;
                margin-bottom: 15px;
                font-size: 1em;
                border-radius: 6px;
                border: none;
                cursor: pointer;
                transition: background-color 0.3s ease;
                color: white;
            }

                .btn-admin.primary {
                    background-color: #007bff;
                }

                    .btn-admin.primary:hover {
                        background-color: #0056b3;
                    }

                .btn-admin.secondary {
                    background-color: #6c757d;
                }

                    .btn-admin.secondary:hover {
                        background-color: #545b62;
                    }

                .btn-admin.outline {
                    background-color: transparent;
                    border: 2px solid #343a40;
                    color: #343a40;
                }

                    .btn-admin.outline:hover {
                        background-color: #343a40;
                        color: white;
                    }
        </style>
}
