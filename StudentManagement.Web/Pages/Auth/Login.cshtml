@page
@model StudentManagement.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}

<div class="login-container">
    <h2>Přihlášení</h2>

    <form method="post">
        <div class="form-group">
            <label>Uživatelské jméno</label>
            <input asp-for="LoginData.UzivatelskeJmeno" class="form-control" />
        </div>

        <div class="form-group">
            <label>Heslo</label>
            <input asp-for="LoginData.Heslo" type="password" class="form-control" />
        </div>

        <button type="submit" class="btn-login">Přihlásit se</button>

        @if (Model.Chyba != null)
        {
            <p class="error">@Model.Chyba</p>
        }
    </form>
</div>

<style>
    .login-container {
        max-width: 500px;
        margin: 120px auto;
        background-color: #f9f9f9;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        font-family: "Segoe UI", sans-serif;
    }

        .login-container h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #333;
        }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            color: #444;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1em;
    }

    .btn-login {
        width: 100%;
        background-color: #007bff;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-size: 1em;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .btn-login:hover {
            background-color: #0056b3;
        }

    .error {
        color: red;
        margin-top: 10px;
        text-align: center;
    }
</style>
