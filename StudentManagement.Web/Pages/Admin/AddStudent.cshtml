@page
@model StudentManagement.Web.Pages.Admin.AddStudentModel
@{
    ViewData["Title"] = "Přidat studenta";
}

<div class="login-container">
    <h2>Přidat nového studenta</h2>

    <div class="text-end mb-3">
        <a asp-page="/Admin/Dashboard" class="btn btn-outline-secondary">Zpět do menu</a>
    </div>

    <form method="post">
        <div class="form-group">
            <label>Jméno</label>
            <input asp-for="NewStudent.Jmeno" class="form-control" />
        </div>

        <div class="form-group">
            <label>Příjmení</label>
            <input asp-for="NewStudent.Prijmeni" class="form-control" />
        </div>

        <div class="form-group">
            <label>Datum narození</label>
            <input asp-for="NewStudent.DatumNarozeni" type="date" class="form-control" />
        </div>

        <div class="form-group">
            <label>Ročník</label>
            <select asp-for="NewStudent.RocnikId" asp-items="Model.GradesSelectList" class="form-control">
                <option value="">-- Vyberte ročník --</option>
            </select>
        </div>

        <div class="form-group">
            <label>Předměty (podržte Ctrl pro výběr více)</label>
            <select asp-for="NewStudent.ZvolenePredmety" asp-items="@(new MultiSelectList(Model.AvailableSubjects, "Id", "Nazev"))" class="form-control" multiple size="6">
            </select>
        </div>

        <button type="submit" class="btn-login">Vytvořit studenta</button>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <p class="info">@Model.StatusMessage</p>
        }
    </form>
</div>

<style>
    .login-container {
        max-width: 500px;
        margin: 120px auto;
        background-color: #f9f9f9;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        font-family: "Segoe UI", sans-serif;
    }

        .login-container h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #333;
        }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-weight: bold;
            color: #444;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1em;
    }

    .btn-login {
        width: 100%;
        background-color: #007bff;
        color: white;
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-size: 1em;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .btn-login:hover {
            background-color: #0056b3;
        }

    .info {
        margin-top: 15px;
        color: green;
        text-align: center;
    }
</style>
